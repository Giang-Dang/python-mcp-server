# Copy to .env.mcp. Only runtime credentials belong here.
SHOPMCP_AUTH0_DOMAIN=your-tenant.auth0.com
SHOPMCP_HOST=127.0.0.1
SHOPMCP_PORT=8000
SHOPMCP_POSTGRES_HOST=127.0.0.1
SHOPMCP_POSTGRES_PORT=5433
SHOPMCP_SHOP_DATABASE=shop
SHOPMCP_AUDIT_DATABASE=mcp_audit
SHOPMCP_READER_PASSWORD=replace_me
SHOPMCP_WRITER_PASSWORD=replace_me
SHOPMCP_PROCEDURE_PASSWORD=replace_me
SHOPMCP_MONITOR_PASSWORD=replace_me
SHOPMCP_AUDIT_PASSWORD=replace_me
SHOPMCP_TENANT_ID=1
# Defaults can be lowered:
SHOPMCP_REQUEST_BYTES=65536
SHOPMCP_RESULT_ROWS=1000
SHOPMCP_RESULT_BYTES=1048576
SHOPMCP_READ_SECONDS=15
SHOPMCP_WRITE_SECONDS=30
SHOPMCP_PROCEDURE_SECONDS=60
SHOPMCP_AFFECTED_ROWS=1000
SHOPMCP_APPROVAL_SECONDS=300
SHOPMCP_PLAN_COST=1000000
