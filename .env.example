# Copy to .env and change the passwords. .env is git-ignored.

# Connection (host side). Port 5433 avoids clashing with a local Postgres on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=shop

# Superuser used by Docker to bootstrap the database and by tests that need admin rights.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres

# Application roles created by db/init/001_roles.sql
SHOP_OWNER_PASSWORD=change_me_owner
LOADER_PASSWORD=change_me_loader
MCP_READER_PASSWORD=change_me_reader
MCP_WRITER_PASSWORD=change_me_writer
MCP_PROC_EXEC_PASSWORD=change_me_proc

# Seeder
SHOP_SCALE=S
SHOP_SEED=42
